<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>ClaudeStatusBar</string>
    <key>CFBundleDisplayName</key>
    <string>Claude Status</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>pt-BR</string>
    </array>
    <key>CFBundleIdentifier</key>
    <string>net.eduapx.ClaudeStatusBar</string>
    <key>CFBundleExecutable</key>
    <string>ClaudeStatusBar</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- __VERSION__ e __BUILD__ são substituídos por build-app.sh -->
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUILD__</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- As chaves do Sparkle (SUFeedURL, SUPublicEDKey, SUEnableAutomaticChecks,
         SUScheduledCheckInterval) são inseridas por build-app.sh quando existe
         SPARKLE_PUBLIC_ED_KEY. Sem elas o app não tenta auto-atualizar. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright 2026 Cotia Labs. PolyForm Noncommercial License 1.0.0.</string>
</dict>
</plist>
